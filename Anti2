--==================================================
-- SET SPEED
--==================================================

local function setSpeed(value)

	value = tonumber(value)

	if not value then
		return
	end

	value = math.clamp(
		value,
		MIN_SPEED,
		MAX_SPEED
	)

	value = math.floor(
		value * 100 + 0.5
	) / 100

	EQUIP_SPEED = value

	speedValue.Text =
		string.format(
			"%.2f s",
			EQUIP_SPEED
		)

	speedBox.Text =
		string.format(
			"%.2f",
			EQUIP_SPEED
		)

	local percent =
		(EQUIP_SPEED - MIN_SPEED) /
		(MAX_SPEED - MIN_SPEED)

	sliderFill.Size =
		UDim2.new(
			percent,
			0,
			1,
			0
		)

	sliderButton.Position =
		UDim2.new(
			percent,
			0,
			0.5,
			0
		)

end

setSpeed(EQUIP_SPEED)

--==================================================
-- SLIDER
--==================================================

local sliderDragging = false

local function updateSlider(input)

	local x =
		input.Position.X -
		sliderBackground.AbsolutePosition.X

	local percent =
		math.clamp(
			x / sliderBackground.AbsoluteSize.X,
			0,
			1
		)

	local value =
		MIN_SPEED +
		(
			(MAX_SPEED - MIN_SPEED)
			* percent
		)

	setSpeed(value)

end

